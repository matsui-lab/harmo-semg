{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matsui-lab.github.io/emg-atlas/schemas/qualification-config-1.0.0.json",
  "title": "EMG ATLAS qualification configuration",
  "type": "object",
  "required": [
    "recording_id",
    "study_id",
    "subject_id",
    "session_id",
    "channel_units",
    "channel_metadata",
    "validation_profile",
    "comparison"
  ],
  "properties": {
    "recording_id": {"type": "string", "minLength": 1},
    "study_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "time_column": {"type": "string", "minLength": 1},
    "sensor_type": {"type": "string", "minLength": 1},
    "source_uri": {"type": "string", "minLength": 1},
    "source_dataset_release": {"type": "string", "minLength": 1},
    "regularity_tolerance": {"type": "number", "minimum": 0},
    "channel_units": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "channel_metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "muscle": {"type": "string", "minLength": 1},
          "side": {
            "enum": ["left", "right", "midline", "unknown"]
          },
          "sensor_type": {"type": "string", "minLength": 1},
          "source_name": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "validation_profile": {
      "type": "object",
      "required": ["expected_sampling_rate_hz"],
      "properties": {
        "sampling_rate_min_hz": {"type": "number", "exclusiveMinimum": 0},
        "sampling_rate_max_hz": {"type": "number", "exclusiveMinimum": 0},
        "expected_sampling_rate_hz": {"type": "number", "exclusiveMinimum": 0},
        "expected_start_seconds": {"type": "number"},
        "time_tolerance_samples": {"type": "number", "minimum": 0},
        "require_array_checksum": {"type": "boolean"},
        "units_by_sensor_type": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "required_channel_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "expected_sides_by_channel": {
          "type": "object",
          "additionalProperties": {
            "enum": ["left", "right", "midline", "unknown"]
          }
        },
        "expected_muscles_by_channel": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "expected_coordinates_by_channel": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {"type": "number"}
          }
        }
      },
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "required": [
        "variable",
        "intended_use",
        "reference_channel_id",
        "recording_channel_id"
      ],
      "properties": {
        "variable": {"type": "string", "minLength": 1},
        "intended_use": {
          "enum": [
            "activation-timing",
            "waveform-shape",
            "amplitude-pooling"
          ]
        },
        "reference_channel_id": {"type": "string", "minLength": 1},
        "recording_channel_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "release_policy": {
      "type": "object",
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "required_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "semantic_fidelity",
              "scientific_validity",
              "computational_reproducibility",
              "traceability"
            ]
          }
        },
        "allow_trust_warnings": {"type": "boolean"},
        "allow_conditional_comparability": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
