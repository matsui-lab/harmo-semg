{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matsui-lab.github.io/emg-atlas/schemas/opensim-artifact-1.0.0.json",
  "title": "OpenSimArtifact",
  "type": "object",
  "required": ["artifact_id", "recording_id", "model", "outputs", "schema_version"],
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "uri", "sha256", "media_type", "digest_kind"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "media_type": {"type": ["string", "null"]},
        "digest_kind": {"enum": ["sha256-file", "sha256-canonical-json"]}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1},
    "recording_id": {"type": "string", "minLength": 1},
    "model": {"$ref": "#/$defs/artifact"},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "ik_rms_error_m": {"type": ["number", "null"], "minimum": 0},
    "ik_max_error_m": {"type": ["number", "null"], "minimum": 0},
    "residual_force_fraction_peak": {"type": ["number", "null"], "minimum": 0},
    "residual_force_fraction_rms": {"type": ["number", "null"], "minimum": 0},
    "residual_moment_fraction_peak": {"type": ["number", "null"], "minimum": 0},
    "residual_moment_fraction_rms": {"type": ["number", "null"], "minimum": 0},
    "rra_angle_change_rms_deg": {"type": ["number", "null"], "minimum": 0},
    "manifest_run_id": {"type": ["string", "null"], "minLength": 1},
    "schema_version": {"const": "1.0.0"}
  },
  "additionalProperties": false
}
