{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matsui-lab.github.io/emg-atlas/schemas/semantic-coverage-comparison-1.0.0.json",
  "title": "File-only versus paper-assisted semantic coverage",
  "type": "object",
  "required": [
    "schema_version",
    "enrichment_report_sha256",
    "study_rows",
    "summary",
    "claim_boundary",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "enrichment_report_sha256": {"$ref": "#/$defs/sha256"},
    "study_rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/study"}
    },
    "summary": {
      "type": "object",
      "required": [
        "study_count",
        "studies_with_file_only_evidence",
        "studies_with_authority_evidence",
        "studies_with_literature_added_properties",
        "emg_semantic_study_count",
        "studies_with_literature_added_emg_properties",
        "file_only_study_property_pairs",
        "paper_assisted_study_property_pairs",
        "literature_added_study_property_pairs",
        "corroborated_authority_claim_count",
        "boundary_claim_count",
        "conflicting_claim_count",
        "unresolved_claim_count"
      ],
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "claim_boundary": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "propertyList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "sourceList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "study": {
      "type": "object",
      "required": [
        "study_id",
        "file_only_claim_count",
        "file_only_property_count",
        "file_only_properties",
        "authority_enrichment_claim_count",
        "authority_enrichment_property_count",
        "authority_enrichment_properties",
        "paper_assisted_property_count",
        "paper_assisted_properties",
        "properties_added_by_literature_count",
        "properties_added_by_literature",
        "corroborated_authority_claim_count",
        "boundary_claim_count",
        "boundary_properties",
        "conflicting_claim_count",
        "unresolved_claim_count",
        "emg_semantics_present",
        "paper_adds_emg_semantics",
        "authority_source_ids",
        "observation_source_ids"
      ],
      "properties": {
        "study_id": {"type": "string", "minLength": 1},
        "file_only_claim_count": {"type": "integer", "minimum": 0},
        "file_only_property_count": {"type": "integer", "minimum": 0},
        "file_only_properties": {"$ref": "#/$defs/propertyList"},
        "authority_enrichment_claim_count": {"type": "integer", "minimum": 0},
        "authority_enrichment_property_count": {"type": "integer", "minimum": 0},
        "authority_enrichment_properties": {"$ref": "#/$defs/propertyList"},
        "paper_assisted_property_count": {"type": "integer", "minimum": 0},
        "paper_assisted_properties": {"$ref": "#/$defs/propertyList"},
        "properties_added_by_literature_count": {"type": "integer", "minimum": 0},
        "properties_added_by_literature": {"$ref": "#/$defs/propertyList"},
        "corroborated_authority_claim_count": {"type": "integer", "minimum": 0},
        "boundary_claim_count": {"type": "integer", "minimum": 0},
        "boundary_properties": {"$ref": "#/$defs/propertyList"},
        "conflicting_claim_count": {"type": "integer", "minimum": 0},
        "unresolved_claim_count": {"type": "integer", "minimum": 0},
        "emg_semantics_present": {"type": "boolean"},
        "paper_adds_emg_semantics": {"type": "boolean"},
        "authority_source_ids": {"$ref": "#/$defs/sourceList"},
        "observation_source_ids": {"$ref": "#/$defs/sourceList"}
      },
      "additionalProperties": false
    }
  }
}
