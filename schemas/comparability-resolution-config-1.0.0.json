{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matsui-lab.github.io/emg-atlas/schemas/comparability-resolution-config-1.0.0.json",
  "title": "Activation-timing comparability resolution configuration",
  "type": "object",
  "required": [
    "resolution_id",
    "compatibility_group",
    "intended_use",
    "variable",
    "common_grid",
    "validation_evidence",
    "left",
    "right"
  ],
  "properties": {
    "resolution_id": {"type": "string", "minLength": 1},
    "compatibility_group": {"type": "string", "minLength": 1},
    "intended_use": {"const": "activation-timing"},
    "variable": {"type": "string", "minLength": 1},
    "common_grid": {
      "type": "object",
      "required": ["points", "landmark_start", "landmark_end"],
      "properties": {
        "points": {"type": "integer", "minimum": 2},
        "landmark_start": {"type": "string", "minLength": 1},
        "landmark_end": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "validation_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["uri", "path", "sha256"],
        "properties": {
          "uri": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "media_type": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "left": {"$ref": "#/$defs/side"},
    "right": {"$ref": "#/$defs/side"},
    "release_policy": {
      "type": "object",
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "required_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "semantic_fidelity",
              "scientific_validity",
              "computational_reproducibility",
              "traceability"
            ]
          }
        },
        "allow_trust_warnings": {"type": "boolean"},
        "allow_conditional_comparability": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "side": {
      "type": "object",
      "required": [
        "comparison_channel_id",
        "side",
        "event_method",
        "processing"
      ],
      "properties": {
        "comparison_channel_id": {"type": "string", "minLength": 1},
        "side": {"enum": ["left", "right", "midline"]},
        "event_method": {"type": "string", "minLength": 1},
        "processing": {
          "type": "object",
          "required": [
            "representation",
            "mean_center",
            "rectification",
            "amplitude_normalization"
          ],
          "properties": {
            "representation": {
              "enum": ["envelope", "normalized-envelope"]
            },
            "mean_center": {"type": "boolean"},
            "bandpass_hz": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "array",
                  "prefixItems": [
                    {"type": "number", "exclusiveMinimum": 0},
                    {"type": "number", "exclusiveMinimum": 0}
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              ]
            },
            "butterworth_order": {"type": "integer", "minimum": 1},
            "zero_phase": {"type": "boolean"},
            "rectification": {"enum": ["none", "absolute"]},
            "hampel_window_seconds": {
              "type": ["number", "null"],
              "exclusiveMinimum": 0
            },
            "hampel_sigma": {"type": "number", "exclusiveMinimum": 0},
            "rms_window_seconds": {
              "type": ["number", "null"],
              "exclusiveMinimum": 0
            },
            "amplitude_normalization": {"enum": ["none", "cycle-max"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
