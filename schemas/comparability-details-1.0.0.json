{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matsui-lab.github.io/emg-atlas/schemas/comparability-details-1.0.0.json",
  "title": "Comparability pre-aggregation group findings",
  "type": "object",
  "required": ["schema_version", "detail_version", "assertion", "assertion_sha256", "check_groups", "input_evidence_refs", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "detail_version": {"const": "harmo-comparability-details/1.0.0"},
    "assertion": {"type": "object", "description": "Validated separately against its unchanged comparability-assertion schema.", "required": ["status", "rationale", "conditions", "rule_version", "schema_version"]},
    "assertion_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "check_groups": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["check_id", "execution", "findings"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "execution": {"enum": ["executed", "not_selected"]},
          "outcome": {"enum": ["findings", "no_findings"]},
          "findings": {"type": "array", "items": {
            "type": "object", "required": ["kind", "reason"],
            "properties": {"kind": {"enum": ["incompatibility", "unresolved", "condition"]}, "reason": {"type": "string", "minLength": 1}},
            "additionalProperties": false
          }}
        },
        "allOf": [{"if": {"properties": {"execution": {"const": "executed"}}}, "then": {"required": ["outcome"]}, "else": {"properties": {"findings": {"maxItems": 0}}, "not": {"required": ["outcome"]}}}],
        "additionalProperties": false
      }
    },
    "input_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
