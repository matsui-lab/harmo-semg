{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matsui-lab.github.io/emg-atlas/schemas/recording-bundle-1.0.0.json",
  "title": "HarmoRecordingBundle",
  "type": "object",
  "required": ["schema_version", "recording_id", "study_id", "subject_id", "session_id", "samples", "timebase", "channels", "sources"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "recording_id": {"type": "string", "minLength": 1},
    "study_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "samples": {
      "type": "object",
      "required": ["uri", "format", "dtype", "shape"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "dtype": {"type": "string", "minLength": 1},
        "shape": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "minItems": 2, "maxItems": 2},
        "checksum": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "timebase": {
      "type": "object",
      "required": ["sampling_rate_hz", "sample_count", "start_seconds", "clock"],
      "properties": {
        "sampling_rate_hz": {"type": "number", "exclusiveMinimum": 0},
        "sample_count": {"type": "integer", "minimum": 1},
        "start_seconds": {"type": "number"},
        "timestamps_uri": {"type": ["string", "null"]},
        "clock": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["channel_id", "name", "unit", "sensor_type"],
        "properties": {
          "channel_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "sensor_type": {"type": "string", "minLength": 1},
          "muscle": {"type": ["string", "null"]},
          "side": {"enum": ["left", "right", "midline", "unknown", null]},
          "coordinates": {"type": ["object", "null"], "additionalProperties": {"type": "number"}},
          "source_name": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["uri", "sha256"],
        "properties": {
          "uri": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": ["integer", "null"], "minimum": 0},
          "media_type": {"type": ["string", "null"]},
          "dataset_release": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "onset_seconds", "label", "duration_seconds", "source_label", "hed_tags"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "onset_seconds": {"type": "number", "minimum": 0},
          "label": {"type": "string", "minLength": 1},
          "duration_seconds": {"type": "number", "minimum": 0},
          "source_label": {"type": ["string", "null"]},
          "hed_tags": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message", "field", "evidence", "dimension"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "severity": {"enum": ["info", "warning", "error"]},
          "message": {"type": "string"},
          "field": {"type": ["string", "null"]},
          "evidence": {"type": ["string", "null"]},
          "dimension": {"enum": ["semantic_fidelity", "scientific_validity", "computational_reproducibility", "traceability"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
