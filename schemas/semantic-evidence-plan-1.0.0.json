{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matsui-lab.github.io/emg-atlas/schemas/semantic-evidence-plan-1.0.0.json",
  "title": "Frozen scope-aware semantic evidence extraction plan",
  "type": "object",
  "required": ["schema_version", "purpose", "claim_boundary", "sources"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "purpose": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "study_id",
        "source_type",
        "source_role",
        "identifier",
        "format",
        "release_binding",
        "claims"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "study_id": {"type": "string", "minLength": 1},
        "source_type": {
          "enum": [
            "peer-reviewed-article",
            "supplement",
            "repository-metadata",
            "readme",
            "data-dictionary",
            "repository-config",
            "data-file"
          ]
        },
        "source_role": {"enum": ["authority", "observation"]},
        "identifier": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "path": {"type": "string", "minLength": 1},
        "format": {"enum": ["jats-xml", "xml", "html", "text", "yaml", "json"]},
        "release_binding": {"type": "string", "minLength": 1},
        "expected_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/claim"}
        }
      },
      "oneOf": [
        {"required": ["url"], "not": {"required": ["path"]}},
        {"required": ["path"], "not": {"required": ["url"]}}
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "property_path",
        "scope_level",
        "pattern"
      ],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "property_path": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
        },
        "scope_level": {
          "enum": [
            "dataset",
            "cohort",
            "subject",
            "session",
            "trial",
            "channel-group",
            "channel"
          ]
        },
        "scope_selector": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "propagation": {"enum": ["none", "all-descendants"]},
        "machine_action": {"enum": ["enrich", "boundary-only"]},
        "locator": {"type": "string", "minLength": 1},
        "pattern": {"type": "string", "minLength": 1},
        "mode": {"enum": ["capture", "presence", "count", "set"]},
        "value_type": {"enum": ["number", "integer", "boolean", "string"]},
        "expected": {},
        "dotall": {"type": "boolean"},
        "requires_human_review": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
