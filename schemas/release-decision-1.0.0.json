{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matsui-lab.github.io/emg-atlas/schemas/release-decision-1.0.0.json",
  "title": "ReleaseDecision",
  "type": "object",
  "required": [
    "decision_id",
    "subject_id",
    "intended_use",
    "status",
    "policy_id",
    "policy_version",
    "recording_sha256",
    "manifest_sha256",
    "trust_report_sha256",
    "comparability_assertion_sha256",
    "required_dimensions",
    "reasons",
    "conditions",
    "decided_at",
    "schema_version"
  ],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "intended_use": {"type": "string", "minLength": 1},
    "status": {"enum": ["allow", "conditional", "quarantine", "deny"]},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "recording_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trust_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "comparability_assertion_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "required_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "semantic_fidelity",
          "scientific_validity",
          "computational_reproducibility",
          "traceability"
        ]
      }
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "conditions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "decided_at": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0.0"}
  },
  "additionalProperties": false
}
